<Page x:Class="GameOp.Pages.DashboardPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />

            <!-- Device card -->
            <ui:Card Margin="0,12,0,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="XboxController24" FontSize="44" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DeviceName" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="DeviceApu" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <WrapPanel x:Name="SpecChips" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryText" FontSize="18" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RefreshText" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar x:Name="AutoBar" Margin="0,12,0,0" IsOpen="True" IsClosable="False" Severity="Informational" Title="Auto power per game" />

            <TextBlock Text="Performance profile" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Sets APU power (TDP), Windows power mode, CPU boost and refresh rate. Tick the box to also write each emulator's global graphics settings for this level." />
            <UniformGrid x:Name="TierGrid" Columns="4" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="IncludeEmulators" Content="Also apply to all detected emulators" IsChecked="True" VerticalAlignment="Center" />
                <ui:Button x:Name="ApplyButton" Content="Apply" Appearance="Primary" Margin="16,0,0,0" Padding="28,8" Click="OnApply">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Flash24" /></ui:Button.Icon>
                </ui:Button>
                <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="24" Height="24" Margin="12,0,0,0" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Text="Activity" Style="{StaticResource SectionHeader}" />
            <ui:Card Padding="0">
                <ListBox x:Name="LogList" Height="240" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
