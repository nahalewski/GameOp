<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameOp</AssemblyName>
    <RootNamespace>GameOp</RootNamespace>
    <!-- dotnet build -p:NoElevate=true gives a non-admin build for UI previews. -->
    <ApplicationManifest Condition="'$(NoElevate)' != 'true'">app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>GameOp – ROG Ally Optimizer</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data files are embedded so GameOp is a single .exe (a Data\ folder next to the exe still overrides them). -->
    <EmbeddedResource Include="Data\*.json" LogicalName="GameOp.Data.%(Filename)%(Extension)" />
    <None Remove="Data\research\**" />
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
